<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/fxml/1" fx:controller="com.example.drony.HelloController">

  <TableView fx:id="table" VBox.vgrow="ALWAYS">
    <columnResizePolicy>
      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
    </columnResizePolicy>
    <columns>
      <TableColumn fx:id="nameCol" minWidth="150.0" text="Položka" />
      <TableColumn fx:id="amountCol" minWidth="100.0" text="Množství" />
    </columns>
  </TableView>

  <HBox alignment="CENTER" spacing="10.0">
    <Button onAction="#onStartClick" prefWidth="80.0" text="Start" />
    <Button onAction="#onStopClick" prefWidth="80.0" text="Stop" />
  </HBox>
</VBox>